{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.nextleaguemarketing.com"
        }
      ],
      "destination": "https://nextleaguemarketing.com/:path*",
      "permanent": true
    },
    {
      "source": "/missed-call-text-back",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/missed-call-text-back/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/speed-to-lead",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/speed-to-lead/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/riverside",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/riverside/",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/hvac",
      "destination": "/hvac.html"
    },
    {
      "source": "/plumbing",
      "destination": "/plumbing.html"
    },
    {
      "source": "/electrical",
      "destination": "/electrical.html"
    },
    {
      "source": "/roofing",
      "destination": "/roofing.html"
    },
    {
      "source": "/multi-site",
      "destination": "/multi-site.html"
    }
  ]
}
